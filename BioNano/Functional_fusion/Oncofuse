## This script is used to estimate the oncogenic potential of de-novo discovered gene fusions by using Oncofuse (https://github.com/mikessh/oncofuse)
## Before running, make sure to have *coord_oncofuse.txt, a Tab-delimited file with lines 5' chrom	5' coord	3' chrom	3' coord	tissue_type           
#!/bin/bash

#SBATCH --job-name=Oncofuse
#SBATCH -t 1-00:00
#SBATCH --partition=htc
#SBATCH --ntasks-per-node=8
#SBATCH --mem=40GB


# Load modules
module purge
module load gcc/12.2.0
module load singularity/3.9.6
module load oncofuse/1.1.1

# File paths
input_file="/ix1/alee/LO_LAB/Personal/Rahul/BioNano/Functional_Fusion/Oncofuse/Overlapping_fusions_coord_oncofuse.txt"
output_file="/ix1/alee/LO_LAB/Personal/Rahul/BioNano/Functional_Fusion/Oncofuse/results.txt"

# Run Oncofuse
# Tissue of origin: EPI (epithelial)
oncofuse -a hg38 $input_file coord EPI $output_file
