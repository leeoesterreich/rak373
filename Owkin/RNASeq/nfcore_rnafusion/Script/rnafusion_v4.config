// Extras on top of CRC's htc.config (loaded first)
singularity {
  pullTimeout = "2h"
  runOptions = "--bind /vast:/vast --bind /ix1:/ix1 --bind /zfs1:/zfs1"
}

executor {
  queueSize       = 10
  submitRateLimit = '10 / 1min'
}

process {
  withName: 'FUSIONCATCHER_FUSIONCATCHER' {
    memory        = { 36.GB * task.attempt }   // attempt 1 = 36 GB (same as before, keeps finished samples cached), attempt 2 = 72 GB
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2
  }
}
