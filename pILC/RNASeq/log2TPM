# This can generate the TPM matrix from the HTSeq count txt file
# =============================
# TPM Normalization & Mapping
# =============================
library(GenomicFeatures)
library(biomaRt)
library(dplyr)

# === File paths ===
input_dir   <- "/ix1/alee/LO_LAB/Personal/Rahul/pILC/4_Count_file_ILC"
gtf_file    <- "/ix1/alee/LO_LAB/Personal/Rahul/Reference_genome/Human/Human_ref_hg38_p7/gencode.v47.basic.annotation.gtf"

# Output file paths
output_tpm_file      <- file.path(input_dir, "tpm_matrix_ILC.txt")
output_log2_tpm_file <- file.path(input_dir, "tpm_matrix_ILC_log2TPM.txt")
output_map_file      <- file.path(input_dir, "HGNC_to_Ensembl_mapping.txt")

# === Read all HTSeq files ===
count_files <- list.files(input_dir, pattern = "\\.txt$", full.names = TRUE)
count_files <- count_files[!grepl("tpm_matrix", count_files)]  # skip output file if re-running

count_list <- lapply(count_files, function(file) {
  df <- read.table(file, header = FALSE, stringsAsFactors = FALSE)
  colnames(df) <- c("Gene", basename(file))
  return(df)
})

# === Merge all files ===
merged <- Reduce(function(x, y) merge(x, y, by = "Gene"), count_list)
rownames(merged) <- merged$Gene
merged <- merged[, -1]

# === Remove HTSeq summary rows ===
exclude <- c("__no_feature", "__ambiguous", "__too_low_aQual",
             "__not_aligned", "__alignment_not_unique")
merged <- merged[!rownames(merged) %in% exclude, ]

# === Convert to integer matrix ===
gene_ids <- rownames(merged)
merged <- apply(merged, 2, as.integer)
rownames(merged) <- gene_ids
colnames(merged) <- gsub("\\.txt$", "", colnames(merged))  # Clean sample names

# === Strip Ensembl version suffix ===
rownames(merged) <- gsub("\\.\\d+$", "", rownames(merged))

# === Extract gene lengths from GTF ===
txdb <- makeTxDbFromGFF(gtf_file, format = "gtf")
exons <- exonsBy(txdb, by = "gene")
gene_lengths <- sum(width(reduce(exons)))
length_df <- data.frame(
  ensembl_id = names(gene_lengths),
  gene_length_kb = as.numeric(gene_lengths) / 1000
)

# === TPM Normalization ===
merged_df <- data.frame(ensembl_id = rownames(merged), merged)
length_df$ensembl_id <- gsub("\\.\\d+$", "", length_df$ensembl_id)
tpm_input <- merge(merged_df, length_df, by = "ensembl_id")

gene_lengths_kb <- tpm_input$gene_length_kb
raw_counts <- tpm_input[, !(names(tpm_input) %in% c("ensembl_id", "gene_length_kb"))]
rpk <- sweep(raw_counts, 1, gene_lengths_kb, "/")
tpm <- sweep(rpk, 2, colSums(rpk), "/") * 1e6
tpm <- as.data.frame(tpm)
tpm$ensembl_id <- tpm_input$ensembl_id

# === Ensembl to HGNC mapping using biomaRt ===
cat("Querying biomaRt for HGNC symbols...\n")
mart <- useEnsembl("ensembl", dataset = "hsapiens_gene_ensembl", version = 109)

id_map <- getBM(
  attributes = c("ensembl_gene_id", "hgnc_symbol"),
  filters = "ensembl_gene_id",
  values = tpm$ensembl_id,
  mart = mart
)
id_map <- id_map[!duplicated(id_map$ensembl_gene_id), ]
id_map <- id_map[id_map$hgnc_symbol != "", ]

# Pick one consistent Ensembl per HGNC (highest median TPM) ===

# Merge TPM with mapping (keep ensembl_id for selection)
tpm <- merge(tpm, id_map, by.x = "ensembl_id", by.y = "ensembl_gene_id")

# Identify sample columns and ensure numeric
sample_cols <- setdiff(names(tpm), c("ensembl_id", "hgnc_symbol"))
tpm[sample_cols] <- lapply(tpm[sample_cols], function(x) as.numeric(as.character(x)))

# Calculate median TPM across all samples
if (requireNamespace("matrixStats", quietly = TRUE)) {
  med_score <- matrixStats::rowMedians(as.matrix(tpm[sample_cols]), na.rm = TRUE)
} else {
  med_score <- apply(tpm[, sample_cols, drop = FALSE], 1, median, na.rm = TRUE)
}
tpm$score_median <- med_score

# Pick the highest median TPM per HGNC
tpm_best <- tpm %>%
  group_by(hgnc_symbol) %>%
  arrange(desc(score_median), ensembl_id) %>%
  slice(1) %>%
  ungroup()

# Save HGNC to Ensembl mapping
mapping_df <- tpm_best %>% select(hgnc_symbol, ensembl_id)
write.table(mapping_df, output_map_file, sep = "\t", quote = FALSE, row.names = FALSE)

# Final TPM matrix (one row per HGNC)
final_matrix <- tpm_best %>%
  select(hgnc_symbol, all_of(sample_cols)) %>%
  rename(Gene = hgnc_symbol)
colnames(final_matrix)[-1] <- gsub("\\.", "-", colnames(final_matrix)[-1])

# === Save TPM ===
write.table(final_matrix, output_tpm_file, sep = "\t", quote = FALSE, row.names = FALSE)

# === Create log2(TPM + 1) ===
log2_tpm <- final_matrix
log2_tpm[,-1] <- log2(log2_tpm[,-1] + 1)

# === Save log2TPM+1 ===
write.table(log2_tpm, output_log2_tpm_file, sep = "\t", quote = FALSE, row.names = FALSE)

cat("All files saved:\n")
cat("TPM: ", output_tpm_file, "\n")
cat("log2TPM+1: ", output_log2_tpm_file, "\n")
cat("Mapping: ", output_map_file, "\n")
